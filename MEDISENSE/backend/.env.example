# ==========================================
# MediSense Backend - Environment Variables
# Copy this file to .env and fill in real values
# ==========================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/medisense

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace_with_a_random_cookie_secret

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (for verification / password reset - e.g. Gmail App Password, Mailtrap, or Resend SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="MediSense <no-reply@medisense.app>"

# ML Service
ML_SERVICE_URL=http://127.0.0.1:8000

# Google Maps / Places (for nearby clinics)
GOOGLE_MAPS_API_KEY=AIzaSyBBS1a2S5i6SymBp-N4TsCIrvh0mo0NM2w

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Chatbot (Anthropic/OpenAI key if wiring a real LLM; otherwise rule-based fallback is used)
CHAT_LLM_API_KEY=

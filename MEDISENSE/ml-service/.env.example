# MediSense ML Service - Environment Variables
HOST=0.0.0.0
PORT=8000

# Path to the trained Keras model (.h5 / SavedModel dir). If missing, the
# service boots in "mock mode" and returns heuristic predictions so the
# rest of the app is fully demo-able without a trained model.
MODEL_PATH=models/skin_classifier.keras
LABELS_PATH=models/labels.json

IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=0.15

# Restrict which origins may call this service directly (usually just the
# Node backend, not the public internet)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
